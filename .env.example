NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# App role (RLS enforced) and owner role (migrations, seed, outbox relay)
DATABASE_URL=postgres://invai_app:invai@localhost:5432/invai
MIGRATION_DATABASE_URL=postgres://invai:invai@localhost:5432/invai
# Tests claim their own database automatically (invai_test_<pid>, cloned from a migrated
# invai_test_tpl template; T-P1-1, B-228) and drop it when the run ends. Set these only to pin a
# specific database instead (e.g. to inspect it afterwards).
#TEST_DATABASE_URL=postgres://invai_app:invai@localhost:5432/invai_test
#TEST_MIGRATION_DATABASE_URL=postgres://invai:invai@localhost:5432/invai_test

REDIS_URL=redis://localhost:6379
# Tests claim a free Redis DB (1-14) automatically and release it when the run ends (T-P1-1,
# B-228); DB 0 (dev) and DB 15 are never used as a test target. Set this only to pin a specific
# DB instead (must be a non-zero DB, e.g. /14 — never /0)
#TEST_REDIS_URL=redis://localhost:6379/14

# MinIO locally (console on :9001)
S3_BUCKET=invai-local
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=invai
S3_SECRET_ACCESS_KEY=invai-secret
S3_FORCE_PATH_STYLE=true

IMAGING_URL=http://localhost:8000

BETTER_AUTH_SECRET=change-me-32-chars-minimum-xxxxxxxx
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173
FLOOR_ORIGIN=http://localhost:5174
#FLOOR_TOKEN_SECRET=
FLOOR_SESSION_TTL_HOURS=12
# Account security (ADR 0025): 10 wrong passwords per email lock sign-in for 30 minutes (max 10);
# owners and admins must turn on two-step sign-in within MFA_GRACE_DAYS (0-14).
ACCOUNT_LOCK_THRESHOLD=10
ACCOUNT_LOCK_MINUTES=30
MFA_GRACE_DAYS=7

# Field encryption (buyer PII, channel tokens): keyId:base64(32 bytes). Dev key below; rotate by
# prepending a new key: k2:<base64>,k1:<base64>
FIELD_ENCRYPTION_KEY=k1:KzQaGJQ4pwuYge713w7utD2NrzYH21qNtk//UkCed+E=

# Where the field-encryption ring comes from (ADR 0034). static (default) = FIELD_ENCRYPTION_KEY
# only. local = envelope keys for development: wrapped data keys unwrapped at start with a local
# master key; FIELD_ENCRYPTION_KEY stays decrypt-only for older values. Make the master key with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# and each data key with: pnpm exec tsx src/lib/field-keys-cli.ts new-data-key --id d1
# kms is refused at start until the AWS KMS adapter is built (backlog B-327).
# FIELD_ENCRYPTION_PROVIDER=static
# FIELD_ENCRYPTION_LOCAL_MASTER_KEY=
# FIELD_ENCRYPTION_DATA_KEYS=d1:<wrapped>

# Operator token for the internal DLQ routes (/internal/dlq/*, header X-Internal-Token), 32+
# chars. Empty turns the routes off (404). Never ship it to a browser.
INTERNAL_ADMIN_TOKEN=

# Leave empty to use the mock providers. In production (NODE_ENV=production) every key below
# except SS_ACTIVEWEAR_* is required (mail included); boot fails listing what is
# missing unless ALLOW_MOCKS=true (demo or staging only; warns on every start).
# AI: ANTHROPIC_API_KEY wins; OPENAI_API_KEY is used only without it (decision 0021); either one
# satisfies production. Neither = the mock.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
EASYPOST_API_KEY=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SS_ACTIVEWEAR_ACCOUNT=
SS_ACTIVEWEAR_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
#ALLOW_MOCKS=false
# Listing photos AI scenes (T-27-1): `mock` draws sample scenes for free. Only the owner switches
# to `openai` (OI-25; needs OPENAI_API_KEY, real spend per image). Daily cap per shop, UTC day.
#IMAGE_GEN_PROVIDER=mock
#IMAGE_GEN_DAILY_CAP_PER_SHOP=30

# Outgoing mail. Empty = Mailpit locally (smtp://localhost:1025, UI on :8025)
SMTP_URL=
MAIL_FROM=
# Footer postal address for person-facing email (CAN-SPAM). Placeholder until OI-12 is answered.
#MAIL_POSTAL_ADDRESS=InvAI, postal address pending (OI-12), USA

# Weekly digest switches (wave 19). DIGEST_SUMMARY_MODE stays shadow until OI-8.
#DIGEST_ENABLED=true
#DIGEST_EMAIL_ENABLED=true
#DIGEST_SUMMARY_MODE=shadow
#DIGEST_MAX_CENTS_PER_WEEK=10
